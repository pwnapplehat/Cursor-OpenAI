# =============================================================================
# Cursor OpenAI Gateway - environment configuration
# Copy this file to `.env` and fill in the values you need.
# NEVER commit your real `.env` file - it is already listed in .gitignore.
# =============================================================================

# --- Cursor authentication ----------------------------------------------------
# Required unless CURSOR_KEY_MODE=passthrough. Get a user API key from
# https://cursor.com/dashboard/integrations or a team service-account key from
# Team Settings -> Service accounts.
CURSOR_API_KEY=

# "server"      (default) - always use CURSOR_API_KEY above for every request.
# "passthrough" - use the client's `Authorization: Bearer <key>` value as the
#                 Cursor API key for that request instead. Lets one running
#                 gateway serve multiple Cursor accounts, at the cost of not
#                 being able to gate access with AUTH_KEY (see below).
CURSOR_KEY_MODE=server

# --- Gateway HTTP server -------------------------------------------------------
PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# Optional bearer token clients must send to use this gateway (Authorization:
# Bearer <AUTH_KEY>). Leave empty to allow unauthenticated local access.
# Ignored when CURSOR_KEY_MODE=passthrough (the client's bearer token is the
# Cursor key in that mode, so there is nothing left to gate with).
AUTH_KEY=

# Comma-separated list of allowed CORS origins, or * for any origin.
CORS_ORIGIN=*

# --- Cursor agent runtime -------------------------------------------------------
# "local" (default) runs agents on this machine against a scratch working
# directory. "cloud" runs on a Cursor-hosted VM (higher latency per request,
# better isolation from this host).
CURSOR_RUNTIME=local

# Root directory for local agents' isolated per-session working directories.
# Defaults to <project>/.cursor-gateway/workspaces if left empty. Each session
# gets its own subfolder so agents cannot see each other's files.
CURSOR_WORKDIR=

# "agent" (default) is Cursor's standard coding-agent conversation mode.
# "plan" restricts the agent to planning without applying changes.
CURSOR_AGENT_MODE=agent

# Model id passed when a client omits "model" or sends "auto"/"gpt-3.5-turbo"-style
# placeholders that don't map to a real Cursor model. Run `npm run smoke` or hit
# GET /v1/models to see the live catalog for your account.
DEFAULT_MODEL=composer-2.5

# --- Feature toggles -----------------------------------------------------------
# Stream Cursor's chain-of-thought/"thinking" text as OpenAI-style
# `reasoning_content` delta fields (supported by many OpenAI-compatible clients
# for reasoning models). Set to false to omit thinking output entirely.
CURSOR_INCLUDE_THINKING=true

# Reuse a persistent Cursor agent across turns of the same conversation instead
# of replaying full history on every request.
CURSOR_ENABLE_SESSIONS=true

# When sessions are enabled, automatically detect follow-up requests whose
# messages[] extend a previously seen conversation (by hash) and reuse that
# session's agent, even without an explicit session id from the client.
CURSOR_AUTO_SESSION=true

# Milliseconds a cached session may sit idle before it is disposed.
SESSION_TTL_MS=1800000

# Maximum number of live agent sessions to keep cached at once (LRU eviction).
MAX_CACHED_AGENTS=50

# Maximum number of Cursor agent runs this process will execute concurrently.
# Extra requests queue (FIFO) until a slot frees up.
MAX_CONCURRENT_RUNS=8

# Hard timeout for a single chat completion request end-to-end.
REQUEST_TIMEOUT_MS=300000

# Experimental: bridge OpenAI-style `tools`/function-calling through Cursor's
# native custom-tool mechanism. See README "Tool calling" section for the
# documented behavioral differences from OpenAI's own tool-calling contract.
ENABLE_TOOL_BRIDGE=true

# --- Rate limiting ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Logging -----------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Pretty-print logs for local development. Leave false in production so logs
# stay newline-delimited JSON for log aggregators.
LOG_PRETTY=false
